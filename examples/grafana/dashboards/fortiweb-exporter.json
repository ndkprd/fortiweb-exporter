    {
      "id": 25,
      "type": "table",
      "title": "License Status by Service",
      "description": "fortiweb_license_valid and fortiweb_license_expiry_timestamp_seconds, one row per FortiGuard license service.",
      "gridPos": { "x": 8, "y": 43, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "fortiweb_license_valid{instance=~\"$instance\"}",
          "legendFormat": "{{service}}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "fortiweb_license_expiry_timestamp_seconds{instance=~\"$instance\"} * 1000",
          "legendFormat": "{{service}}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "instance": "Instance",
              "service": "Service",
              "Value #A": "Valid",
              "Value #B": "Expiry"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Valid" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "No", "color": "orange", "index": 0 },
                      "1": { "text": "Yes", "color": "blue", "index": 1 }
