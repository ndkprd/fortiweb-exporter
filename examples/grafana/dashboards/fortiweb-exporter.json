      "title": "FortiGuard Registered",
      "description": "fortiweb_registered — whether the FortiWeb appliance is registered with FortiGuard.",
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "fortiweb_registered{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "No", "color": "orange", "index": 0 },
                "1": { "text": "Yes", "color": "blue", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] },
          "color": { "mode": "thresholds" }
        },
